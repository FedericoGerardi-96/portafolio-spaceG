---
import type { Proyecto } from '@/interface/contentfull.interface';
import { Image } from 'astro:assets';

interface Props {
  proyectos: Proyecto[];
}

const { proyectos } = Astro.props;
const [featured, ...rest] = proyectos;
---

<section id='projects' class='relative bg-background/60 px-6 py-32 backdrop-blur-sm'>
  <div class='mx-auto max-w-6xl'>
    {/* Header */}
    <div data-animate class='mb-16 opacity-0' style='animation-delay: 0.1s'>
      <span class='mb-4 inline-block font-mono text-sm text-primary'>{'// Proyectos Seleccionados'}</span>
      <h2 class='text-balance text-3xl font-bold text-foreground sm:text-4xl'>Ingeniería aplicada a productos reales</h2>
      <p class='mt-4 max-w-xl text-pretty text-muted-foreground'>
        No solo escribo código; resuelvo problemas de negocio mediante arquitectura frontend escalable y optimización de rendimiento.
      </p>
    </div>

    {/* Featured Project (MBA o Smiles) */}
    <div class='mb-12'>
      <div data-animate class='group relative opacity-0' style='animation-delay: 0.2s'>
        <div
          class='relative overflow-hidden rounded-2xl border border-border bg-card/40 backdrop-blur-sm transition-all duration-500 group-hover:border-primary/50 group-hover:shadow-xl group-hover:shadow-primary/10'>
          <div class='grid lg:grid-cols-5'>
            {/* Lado Imagen - Ocupa 2/5 */}
            <div class='relative lg:col-span-2 aspect-video lg:aspect-auto overflow-hidden border-b lg:border-b-0 lg:border-r border-border/50'>
              <Image
                src={featured.imagen}
                alt={featured.titulo}
                width={1200}
                height={900}
                class='absolute inset-0 h-full w-full object-cover transition-all duration-700 group-hover:scale-105'
              />
              <div class='absolute inset-0 bg-background/20 group-hover:bg-transparent transition-colors duration-500'></div>
              <div class='absolute left-4 top-4'>
                <span
                  class='rounded-full border border-primary/30 bg-primary/10 px-3 py-1 font-mono text-xs text-primary backdrop-blur-md uppercase tracking-wider'
                  >Top Tier Project</span
                >
              </div>
            </div>

            {/* Lado Contenido - Ocupa 3/5 */}
            <div class='lg:col-span-3 flex flex-col p-8 lg:p-10'>
              <div class='flex justify-between items-center mb-4'>
                <span class='font-mono text-[22px] text-primary/70'>01 — Case Study</span>
                <div class='flex gap-2'>
                  <a
                    href={featured.github}
                    target='_blank'
                    class='p-2 rounded-full bg-foreground opacity-80 hover:opacity-100 text-background transition-colors'
                    ><svg class='h-6 w-6' viewBox='0 0 24 24' fill='currentColor'
                      ><path
                        d='M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z'
                      ></path></svg
                    ></a
                  >
                  <a
                    href={featured.link}
                    target='_blank'
                    class='p-2 rounded-full bg-primary text-primary-foreground hover:scale-110 transition-transform'
                    ><svg class='h-6 w-6' fill='none' viewBox='0 0 24 24' stroke='currentColor' stroke-width='2'
                      ><path d='M7 17L17 7M17 7H7M17 7v10'></path></svg
                    ></a
                  >
                </div>
              </div>

              <h3 class='text-3xl font-bold mb-6 group-hover:text-primary transition-colors'>{featured.titulo}</h3>

              <div class='grid gap-6 mb-8'>
                <div>
                  <h4 class='text-[16px] md:text-[18px] font-mono uppercase tracking-widest text-primary mb-2'>El Desafío</h4>
                  <p class='text-[14px] md:text-[16px] text-muted-foreground leading-relaxed italic border-l-2 border-primary/20 pl-4'>
                    {featured.problema}
                  </p>
                </div>
                <div>
                  <h4 class='text-[16px] md:text-[18px] font-mono uppercase tracking-widest text-primary mb-2'>Solución</h4>
                  <p class='text-[14px] md:text-[16px] text-foreground leading-relaxed'>
                    {featured.solucion}
                  </p>
                </div>
              </div>

              <div class='flex flex-wrap gap-1.5 mt-auto'>
                {
                  featured.tecnologias?.map((t) => (
                    <span class='rounded-md border border-border bg-secondary/50 px-2 py-1 font-mono text-xs md:text-sm text-muted-foreground'>
                      {t}
                    </span>
                  ))
                }
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    {/* Resto de proyectos en Grid */}
    <div class='grid gap-8 sm:grid-cols-2'>
      {
        rest.map((project, i) => (
          <div data-animate class='group relative opacity-0' style={`animation-delay: ${0.3 + i * 0.1}s`}>
            <div class='h-full flex flex-col overflow-hidden rounded-2xl border border-border bg-card/40 backdrop-blur-sm transition-all duration-500 group-hover:border-primary/50'>
              <div class='relative aspect-video overflow-hidden'>
                <Image
                  src={project.imagen}
                  alt={project.titulo}
                  width={800}
                  height={450}
                  class='h-full w-full object-cover grayscale group-hover:grayscale-0 transition-all duration-700'
                />
                <div class='absolute inset-0 bg-background/40 group-hover:opacity-0 transition-opacity' />
                <div class='absolute right-4 top-4 flex gap-2 translate-y-2 opacity-0 group-hover:translate-y-0 group-hover:opacity-100 transition-all'>
                  <a href={project.github} class='p-2 rounded-full bg-background/80 hover:bg-primary transition-colors'>
                    <svg class='h-6 w-6' viewBox='0 0 24 24' fill='currentColor'>
                      <path d='M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z' />
                    </svg>
                  </a>
                </div>
              </div>

              <div class='p-6 flex-1 flex flex-col'>
                <h3 class='text-xl font-bold mb-3 group-hover:text-primary transition-colors'>{project.titulo}</h3>
                <div class='space-y-4 flex-1'>
                  {/* Problema Compacto */}
                  <div>
                    <span class='text-[16px] md:text-[18px] font-mono uppercase tracking-widest text-primary/60 block mb-1'>El Desafío</span>
                    <p class='text-[14px] md:text-[16px] text-muted-foreground leading-relaxed italic border-l-2 border-primary/20 pl-4'>
                      {project.problema}
                    </p>
                  </div>

                  {/* Solución Compacta */}
                  <div>
                    <span class='text-[16px] md:text-[18px] font-mono uppercase tracking-widest text-primary block mb-1'>Solución</span>
                    <p class='text-[14px] md:text-[16px] text-foreground/90 leading-relaxed line-clamp-4'>{project.solucion}</p>
                  </div>
                </div>
                <div class='flex flex-wrap gap-1.5 mt-auto pt-4 border-t border-border/30'>
                  {project.tecnologias.slice(0, 3).map((t) => (
                    <span class='rounded bg-primary/5 px-2 py-0.5 font-mono text-xs md:text-sm text-primary/80 uppercase'>{t}</span>
                  ))}
                </div>
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
